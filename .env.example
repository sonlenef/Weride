# Firebase web config is public configuration, NOT an administrator credential.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Entra tenant hint is UX only. Register a SINGLE-TENANT app in Entra for enforcement.
VITE_MICROSOFT_TENANT_ID=madison.dev
# Never put a Microsoft client secret, service-account key or access token in VITE_*.

# Public rollout flag, not an authorization boundary.
VITE_MICROSOFT_AUTH_READY=false
