{
  "name": "weride-discovery-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/check-bundle.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:rules": "firebase emulators:exec --only firestore --project demo-weride 'node --test --test-concurrency=1 tests/firestore.rules.test.mjs tests/pic.rules.test.mjs tests/questions.rules.test.mjs tests/ux-collaboration.rules.test.mjs'",
    "seed": "node scripts/seed.mjs",
    "configure": "node scripts/configure.mjs",
    "deploy": "node scripts/deploy.mjs",
    "seed:review-context": "node scripts/seed-review-context.mjs",
    "test:review-api": "npm --prefix functions test",
    "test:review-integration": "firebase emulators:exec --only firestore --project demo-weride 'npm --prefix functions run test:integration'",
    "deploy:review-sharing": "node scripts/deploy-review-sharing.mjs",
    "sync:members": "node scripts/sync-members.mjs"
  },
  "dependencies": {
    "firebase": "^12.0.0",
    "i18next": "^25.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@google-cloud/firestore": "^9.2.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "firebase-admin": "^13.0.0",
    "google-auth-library": "^11.1.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.0",
    "vitest": "^3.2.0"
  }
}
